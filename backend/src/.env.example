# Embedding Model
E5_MODEL_NAME=intfloat/e5-large-v2
E5_DEVICE=cuda

# Milvus Local (No token needed for local deployment)
MILVUS_URI=http://milvus-standalone:19530
MILVUS_TOKEN=
MILVUS_DB=default
MILVUS_COLLECTION=kg_entities

# HNSW Index Configuration
# M: Number of bi-directional links created for each element (4-64, default: 16)
#    - Higher M = better recall but more memory usage
#    - Recommended: 16 for general use, 32-48 for high accuracy needs
HNSW_M=16

# efConstruction: Size of the dynamic candidate list for constructing the index (100-500, default: 200)
#    - Higher efConstruction = better index quality but slower build time
#    - Recommended: 200 for general use, 400+ for maximum quality
HNSW_EF_CONSTRUCTION=200

# ef: Size of the dynamic candidate list for search (top_k to 32768, default: 128)
#    - Higher ef = better recall but slower search
#    - Should be >= top_k (number of results you want)
#    - Recommended: 128 for general use, 256+ for high accuracy needs
HNSW_EF=128

# Neo4j Graph Database (Docker)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kguser2005

# Google Gemini API (REQUIRED - Get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash-exp

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
